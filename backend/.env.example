# COGNICODE Backend Environment Configuration Example
# Copy this file to backend/.env and adjust values for your environment.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (Local Development): sqlite:///./dev.db
# PostgreSQL (Production): postgresql+psycopg2://user:password@localhost:5432/cognicode
DATABASE_URL=sqlite:///./dev.db

# ── Security & Authentication ────────────────────────────────────────────────
# Must be at least 32 characters in production
JWT_SECRET=insecure-development-secret-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# ── Central AI Brain & Providers ─────────────────────────────────────────────
# Options: none | openai | azure | local
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_S=10.0

# ── Isolated Code Execution Sandbox ──────────────────────────────────────────
# Options: http://localhost:2358 (Standard Judge0 instance)
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=
JUDGE0_WAIT=true

# ── Demonstration & Simulation Flags ─────────────────────────────────────────
# When true, runs in offline simulated mode without requiring Docker/Judge0 daemon
DEMO_MODE=true

# ── CORS Settings ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
