# =============================================================================
# Code Arena AI Brain — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
APP_ENV=development                     # development | production | test
APP_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING_MIN_32_CHARS
APP_DEBUG=false
APP_VERSION=1.0.0
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
API_MAX_REQUEST_SIZE_MB=10
API_RATE_LIMIT_PER_MINUTE=60

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://aibrain:CHANGE_ME@localhost:5433/code_arena_ai_brain
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# --- Qdrant (vector database) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                         # Leave empty for local unauthenticated instance
QDRANT_COLLECTION_NAME=code_arena_knowledge

# --- AI Inference (Ollama) ---
INFERENCE_PROVIDER=ollama               # ollama | openai_compat | mock (for tests only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b                   # Exact model tag as shown in `ollama list`
INFERENCE_TIMEOUT_SECONDS=60
INFERENCE_MAX_TOKENS=2048
INFERENCE_MAX_CONCURRENT=4
INFERENCE_RETRY_ATTEMPTS=2

# --- Embeddings (BGE-M3) ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu                    # cpu | cuda | mps
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=./model_cache

# --- Reranker (optional, comment out to disable) ---
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=5

# --- RAG ---
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.6

# --- Judge0 (code execution sandbox) ---
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=                      # Required for hosted Judge0
JUDGE0_MAX_CPU_TIME=5                   # seconds
JUDGE0_MAX_MEMORY_KB=262144            # 256 MB
JUDGE0_MAX_FILE_SIZE_KB=1024
JUDGE0_TIMEOUT_SECONDS=30

# --- Authentication ---
# Integration mode: set to 'external' when integrating with Code Arena's auth
AUTH_MODE=jwt                           # jwt | external | dev_bypass_UNSAFE
JWT_SECRET_KEY=CHANGE_ME_DIFFERENT_FROM_APP_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Demo / Development only ---
# These are used ONLY in APP_ENV=development with AUTH_MODE=jwt
# Do NOT use in production
DEV_ADMIN_EMAIL=admin@dev.local
DEV_ADMIN_PASSWORD=CHANGE_ME_DEV_ONLY

# --- Mastery algorithm ---
MASTERY_WINDOW_ATTEMPTS=5              # Recent attempts to consider
MASTERY_PASS_THRESHOLD=0.7             # Score fraction to count as pass
MASTERY_STRONG_RATIO=0.8               # Pass ratio for "strong" mastery
MASTERY_WEAK_RATIO=0.4                 # Pass ratio below which skill is weak

# --- CORS ---
CORS_ALLOW_CREDENTIALS=true
