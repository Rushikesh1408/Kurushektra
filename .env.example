# ---- Copy to .env and fill in. Never commit .env ----
# Database
POSTGRES_USER=codearena
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codearena
DATABASE_URL=postgresql+psycopg://codearena:change-me@db:5432/codearena

# Auth (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Refresh-token cookie. Keep true in production (HTTPS); false only for plain-http local dev.
COOKIE_SECURE=true
LOGIN_RATE_LIMIT=10/minute

# One-off seed commands (python -m app.seed ...). Remove after use.
SEED_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS (comma separated, exact origins only)
CORS_ORIGINS=http://localhost:5173

# Code execution service (Judge0). Server-side only, never exposed to the frontend.
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=replace-with-judge0-token
JUDGE0_POSTGRES_PASSWORD=change-me-too
JUDGE0_REDIS_PASSWORD=change-me-three

# LLM provider for follow-up questions (optional; deterministic fallback is used if unset)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
