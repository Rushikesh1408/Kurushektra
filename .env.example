# COGNICODE Root Environment Configuration Example
# Copy this file to .env and adjust values for your environment.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./dev.db

# ── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=insecure-development-secret-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# ── Central AI Brain & Providers ─────────────────────────────────────────────
LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_S=10.0

# ── Isolated Code Execution Sandbox ──────────────────────────────────────────
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=
JUDGE0_WAIT=true

# ── Demonstration & Simulation Flags ─────────────────────────────────────────
DEMO_MODE=true

# ── Frontend Configuration ───────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
